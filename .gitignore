# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ai 插件
/.trellis
/.agents

# testing
/coverage

# next.js
/.next/
/out/
/.codex

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.crt
*.p12
*.pfx
*.cert
*.credentials.json
secrets.*
*.secret

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment and secrets
# Keep real API keys, database URLs, auth secrets, and deployment addresses out of git.
.env
.env.*
.env*.local
.env.*.local
!.env.example
!.env.sample
!.env.template

# vercel
.vercel/
.netlify/

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin

# local AI / MCP / IDE connector config
.mcp.json
.mcp.*.json
.cursor/mcp.json
.cursor/**/mcp.json
.vscode/mcp.json
.vscode/**/mcp.json

# local editor metadata that can contain machine-specific paths or private prompts
.idea/
*.code-workspace

# generated prisma client
/src/generated/


/openspec
/trellis
