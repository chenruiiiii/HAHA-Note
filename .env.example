# Runtime application database (pooled URL for serverless)
DATABASE_URL=postgresql://user:password@host:5432/haha_note?sslmode=require

# Prisma CLI, migrations, and dump/restore (direct URL)
MIGRATION_DATABASE_URL=postgresql://user:password@host:5432/haha_note?sslmode=require

# mongodb | prisma
DATA_BACKEND=prisma

# Existing MongoDB URI used by the legacy backend and migration scripts
APP_MONGODB_MONGODB_URI=mongodb://user:password@host:27017

# Auth secrets (JWT signing key + password pepper). Use long random values, different per environment.
AUTH_TOKEN_SECRET=replace-with-a-strong-secret
PASSWORD_PEPPER=replace-with-a-strong-pepper

# === AI 对话网关（自有 OpenAI 兼容网关）===
# 必配：AI_PROVIDER_BASE_URL（网关地址，如 https://your-gateway.example.com/v1）
# 必配：AI_PROVIDER_API_KEY（网关密钥；兼容回退 DEEPSEEK_API_KEY）
# 可选：AI_CHAT_MODEL（默认对话模型）、AI_CHAT_ALLOWED_MODELS(逗号分隔白名单)、AI_SUMMARY_MODEL(摘要独立模型)
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
# AI_CHAT_MODEL=deepseek-v4-flash
# AI_CHAT_ALLOWED_MODELS=deepseek-v4-flash
# AI_SUMMARY_MODEL=deepseek-v4-flash

# DeepSeek API key（向后兼容回退：AI_PROVIDER_API_KEY 缺失时使用）
# 同时用于旧版 chat-detail / docs-summary 默认模型
# DEEPSEEK_API_KEY=your_deepseek_api_key

# Required for scripts/migrate-mongo-to-postgres.ts --execute
LEGACY_OWNER_ID=user_id_after_user_migration

# Optional; used by scripts/reverse-sync-cutover.ts (rollback after PostgreSQL writes)
# CUTOVER_TIMESTAMP=2026-09-09T03:00:00Z

NODE_ENV=development
NEXT_PUBLIC_APP_API_URL=http://localhost:3000/api
NEXT_PUBLIC_BASE_URL=http://localhost:3000
